; UART DMA1/2 storage must be in AXI SRAM, not DTCM.
LR_IROM1 0x08000000 0x00100000 {
  ER_IROM1 0x08000000 0x00100000 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
    .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000 {
    .ANY (+RW +ZI)
  }
  RW_IRAM2 0x24000000 0x00050000 {
    bsp_uart.o (+RW +ZI)
    .ANY (+RW +ZI)
  }
}
